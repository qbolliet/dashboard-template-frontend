# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (rapports/traces de npm run test:e2e — les instantanés de référence,
# eux, sont committés : e2e/*.spec.ts-snapshots/)
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/

# next.js
/.next/
src/**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# registry (généré par scripts/build-registry.js, cf. scripts dev / prebuild)
/public/r/
/registry/__registry__.js

# documentation (généré par scripts/build-docs-index.js, cf. scripts dev / prebuild)
/docs/__docs__.js
/docs/__docs-pages__.js

# tables de props (généré par scripts/build-props-doc.js, cf. scripts dev / prebuild)
/docs/__props__.json

# vérification de l'export statique sous sous-chemin (cf. npm run build:docs)
/tmp/

# claude
CLAUDE.md
DESIGN_SYSTEM.md
.claude/*
skills-lock.json

TEMPLATIZATION_ARCHITECTURE.md
TEMPLATIZATION_PROMPTS.md

# old repository
TODO
design-system/*