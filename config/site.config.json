{
  "$schema": "./schema/site.schema.json",
  "site": {
    "title": "Dashboard Template",
    "description": {
      "fr": "Template de tableau de bord pour visualiser des modèles statistiques et de prédiction.",
      "en": "Dashboard template for visualising statistical and prediction models."
    },
    "locales": ["fr", "en"],
    "defaultLocale": "fr"
  },
  "navigation": {
    "type": "sidebar",
    "useSwitcher": false,
    "tree": [
      {
        "path": "/",
        "name": { "fr": "Accueil", "en": "Home" },
        "type": "home",
        "description": {
          "fr": "Vue d'ensemble du tableau de bord et accès aux principaux indicateurs.",
          "en": "Dashboard overview and entry point to the main indicators."
        }
      },
      {
        "path": "/comptabilite-nationale",
        "name": { "fr": "Comptabilité Nationale", "en": "National Accounts" },
        "type": "indicator_group",
        "description": {
          "fr": "Agrégats de la comptabilité nationale, par pays.",
          "en": "National accounts aggregates, by country."
        },
        "keywords": ["INSEE", "SEC 2010"],
        "children": [
          {
            "path": "/france",
            "name": { "fr": "France", "en": "France" },
            "type": "indicator_group",
            "children": [
              {
                "path": "/pib",
                "name": { "fr": "PIB", "en": "GDP" },
                "type": "indicator"
              },
              {
                "path": "/consommation",
                "name": { "fr": "Consommation", "en": "Consumption" },
                "type": "indicator"
              }
            ]
          },
          {
            "path": "/allemagne",
            "name": { "fr": "Allemagne", "en": "Germany" },
            "type": "indicator_group",
            "children": [
              {
                "path": "/pib",
                "name": { "fr": "PIB", "en": "GDP" },
                "type": "indicator"
              },
              {
                "path": "/consommation",
                "name": { "fr": "Consommation", "en": "Consumption" },
                "type": "indicator"
              }
            ]
          }
        ]
      },
      {
        "path": "/finances-publiques",
        "name": { "fr": "Finances Publiques", "en": "Public Finances" },
        "type": "indicator_group",
        "description": {
          "fr": "Recettes et dépenses des administrations publiques.",
          "en": "General government revenue and expenditure."
        },
        "children": [
          {
            "path": "/recettes-publiques",
            "name": { "fr": "Recettes Publiques", "en": "Public Revenue" },
            "type": "indicator",
            "keywords": {
              "fr": ["impôts", "prélèvements obligatoires", "fiscalité"],
              "en": ["taxes", "tax revenue"]
            }
          },
          {
            "path": "/depenses-publiques",
            "name": { "fr": "Dépenses Publiques", "en": "Public Expenditure" },
            "type": "indicator"
          }
        ]
      },
      {
        "path": "/about",
        "name": { "fr": "À propos", "en": "About" },
        "type": "about",
        "description": {
          "fr": "Présentation du projet, sources des données et mentions légales.",
          "en": "Project overview, data sources and legal notices."
        }
      }
    ]
  }
}
